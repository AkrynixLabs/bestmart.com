# Copy to .env and fill in from Supabase Dashboard -> Project Settings -> API.
# Never commit .env. On Vercel, set the same names under Project Settings ->
# Environment Variables (separately for Production / Preview / Development).

# --- Browser (inlined into the JS bundle by Vite, so public by design) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server only (Express API in server/) ---
# Deliberately NOT prefixed VITE_: anything with that prefix ships to the
# browser. The service-role key bypasses row-level security and must only
# ever exist on the server.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Comma-separated extra browser origins allowed to call the API
# (the bundled web app is same-origin and needs none).
# CORS_ORIGINS=https://admin.example.com

# Optional. debug | info | warn | error (default info).
# LOG_LEVEL=info
