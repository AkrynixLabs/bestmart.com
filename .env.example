# Copy to .env and fill in. Never commit .env.
# On Vercel, set the same names under Project Settings -> Environment Variables.

# --- Database ---------------------------------------------------------------
# Local: `npm run db:up` starts Postgres in Docker on port 5433 (see docker-compose.yml).
# Production: Neon. DATABASE_URL = pooled connection, DIRECT_URL = direct (used by migrations).
DATABASE_URL=postgresql://bestmart:bestmart@127.0.0.1:5433/bestmart
DIRECT_URL=postgresql://bestmart:bestmart@127.0.0.1:5433/bestmart

# --- App ----------------------------------------------------------------------
# Public base URL, no trailing slash. Used for links in emails, sitemaps, Paystack callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. debug | info | warn | error (default info).
# LOG_LEVEL=info

# --- Sentry (optional until BestMart's own Sentry project exists) -------------
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# --- Auth (Auth.js) -------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# Optional: "Continue with Google". Redirect URI: <app url>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Email (Resend) -------------------------------------------------------------
# Without a key (development only), emails are written to .data/outbox/.
# RESEND_API_KEY=
# EMAIL_FROM=BestMart <no-reply@yourdomain>

# --- Rate limiting (Upstash Redis) ---------------------------------------------
# Without these, limits are per server instance (fine locally, weak in production).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Private uploads (Vercel Blob, private store) -------------------------------
# Without a token (development only), files go to .data/private/.
# BLOB_READ_WRITE_TOKEN=

# --- Public uploads (Vercel Blob, a second store with public access) -------------
# Product and category photos. Without a token (development only), files go to
# .data/public/ and are served at /media/*.
# PUBLIC_BLOB_READ_WRITE_TOKEN=
