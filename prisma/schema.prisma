// BestMart data model. Business rules behind these fields are in CLAUDE.md.
// Conventions:
//   - Money is always an Int in pesewas (GHS 12.50 = 1250), never a float/decimal.
//   - Percentages are Ints in basis points (10% = 1000), so they stay exact.
//   - Table names are snake_case plural via @@map; Prisma model names are PascalCase.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Platform settings (single row, id = 1). Every business-rule number lives
// here so the Super Admin can change it without a deploy.
// ---------------------------------------------------------------------------

model PlatformSettings {
  id                      Int      @id @default(1)
  currency                String   @default("GHS")
  // Default commission on item price, in basis points (1000 = 10%).
  commissionBps           Int      @default(1000)
  // Stock held for an unpaid checkout before it's released.
  stockReservationMinutes Int      @default(30)
  // A shipped sub-order auto-confirms as delivered after this many days.
  autoConfirmDeliveryDays Int      @default(7)
  // Seller funds become available this many days after delivery confirmation.
  payoutHoldDays          Int      @default(3)
  // Window for faulty / not-as-described return requests after delivery.
  returnWindowDays        Int      @default(7)
  // A variant at or below this stock shows a low-stock flag to its seller.
  lowStockThreshold       Int      @default(5)
  // Delivery fee bands by road distance, ascending:
  // [{ "upToKm": 5, "feePesewas": 1500 }, ..., { "upToKm": null, "feePesewas": 14000 }].
  // Validated in lib/delivery/fee.ts; the last band has no upper limit.
  deliveryBands           Json     @default("[{\"upToKm\":5,\"feePesewas\":1500},{\"upToKm\":10,\"feePesewas\":2000},{\"upToKm\":20,\"feePesewas\":3000},{\"upToKm\":40,\"feePesewas\":4500},{\"upToKm\":100,\"feePesewas\":7000},{\"upToKm\":300,\"feePesewas\":10000},{\"upToKm\":null,\"feePesewas\":14000}]")
  // Straight-line distance x this factor (percent) approximates the road route.
  deliveryRoadFactorPct   Int      @default(130)
  supportEmail            String?
  supportPhone            String?
  updatedAt               DateTime @updatedAt

  @@map("platform_settings")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum Role {
  customer
  seller
  ops_admin
  super_admin
}

enum UserStatus {
  active
  suspended
}

model User {
  id              String     @id @default(cuid())
  // Always stored lower-cased and trimmed (see lib/validation/auth.ts).
  email           String     @unique
  name            String
  phone           String?
  // Null for Google-only accounts.
  passwordHash    String?
  googleId        String?    @unique
  // Self-signups can't log in with a password until this is set.
  emailVerifiedAt DateTime?
  role            Role       @default(customer)
  status          UserStatus @default(active)
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  authTokens           AuthToken[]
  addresses            Address[]
  cart                 Cart?
  orders               Order[]
  sellerApplications   SellerApplication[]  @relation("applicant")
  reviewedApplications SellerApplication[]  @relation("reviewer")
  store                Store?
  auditLogs            AuditLog[]
  reviewedSuggestions  CategorySuggestion[]
  blockedProducts      Product[]            @relation("productBlocker")

  @@map("users")
}

enum AuthTokenPurpose {
  verify_email
  reset_password
}

// Single-use, expiring tokens for email verification and password reset.
// Only a SHA-256 hash is stored; the raw token exists only in the emailed link.
model AuthToken {
  id        String           @id @default(cuid())
  userId    String
  purpose   AuthTokenPurpose
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

// ---------------------------------------------------------------------------
// Addresses
// ---------------------------------------------------------------------------

enum GhanaRegion {
  greater_accra
  ashanti
  western
  western_north
  central
  eastern
  volta
  oti
  northern
  savannah
  north_east
  upper_east
  upper_west
  bono
  bono_east
  ahafo
}

model Address {
  id            String      @id @default(cuid())
  userId        String
  label         String? // e.g. "Home", "Office"
  recipientName String
  phone         String
  region        GhanaRegion
  city          String // town / city, e.g. "Accra", "Tema", "Kumasi"
  area          String // neighbourhood / suburb, e.g. "East Legon"
  streetAddress String?
  landmark      String? // "Opposite the Shell filling station"
  gpsAddress    String? // GhanaPost GPS digital address, e.g. "GA-123-4567"
  // Map pin (WGS84), for distance-based delivery fees. Optional: without
  // it, the area/town centre is used (lib/delivery/towns.ts).
  latitude      Float?
  longitude     Float?
  isDefault     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Sellers
// ---------------------------------------------------------------------------

enum SellerApplicationStatus {
  pending
  approved
  rejected
}

enum BusinessType {
  individual
  registered_business
}

enum PayoutMethod {
  mobile_money
  bank_account
}

// A customer's request to become a seller. A user may re-apply after a
// rejection, but only one application can be pending at a time (partial
// unique index in the migration).
model SellerApplication {
  id                         String                  @id @default(cuid())
  userId                     String
  storeName                  String
  businessType               BusinessType
  businessRegistrationNumber String?
  // KYC. The card image lives in the private Blob store; only admins can
  // fetch it, through an authorised route.
  ghanaCardNumber            String
  ghanaCardImageKey          String
  phone                      String
  region                     GhanaRegion
  city                       String
  categoriesNote             String? // what they plan to sell
  payoutMethod               PayoutMethod
  payoutProvider             String // "MTN", "Telecel", "AirtelTigo" or the bank's name
  payoutAccountName          String
  payoutAccountNumber        String
  status                     SellerApplicationStatus @default(pending)
  reviewedById               String?
  reviewedAt                 DateTime?
  rejectionReason            String?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  user       User   @relation("applicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?  @relation("reviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  store      Store?

  @@index([status, createdAt])
  @@index([userId])
  @@map("seller_applications")
}

enum StoreStatus {
  active
  suspended
}

// Created when an application is approved. Payout details are copied from
// the application; the Paystack transfer recipient is created in Phase 4.
model Store {
  id                  String       @id @default(cuid())
  userId              String       @unique
  applicationId       String       @unique
  slug                String       @unique
  name                String
  description         String?
  logoUrl             String?
  phone               String
  region              GhanaRegion
  city                String
  status              StoreStatus  @default(active)
  // Pickup point for delivery distance. Optional: falls back to the area/town centre.
  pickupArea          String?
  pickupLatitude      Float?
  pickupLongitude     Float?
  payoutMethod        PayoutMethod
  payoutProvider      String
  payoutAccountName   String
  payoutAccountNumber String
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  application         SellerApplication    @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  products            Product[]
  categorySuggestions CategorySuggestion[]
  subOrders           SubOrder[]

  @@map("stores")
}

// ---------------------------------------------------------------------------
// Catalog: categories (admin-managed tree), attributes, products, variants.
// ---------------------------------------------------------------------------

enum CategoryStatus {
  active
  hidden
}

// An admin-managed tree. `path` is the chain of ancestor ids including this
// one ("/root/child/"), used to re-path a subtree when it moves. Reads use
// the cached tree (lib/catalog/categories.ts); the table stays small.
// The admin UI caps depth at 3 levels (0, 1, 2).
model Category {
  id             String         @id @default(cuid())
  parentId       String?
  name           String
  slug           String         @unique
  description    String?
  imageUrl       String?
  path           String
  depth          Int            @default(0)
  sortOrder      Int            @default(0)
  status         CategoryStatus @default(active)
  // Overrides PlatformSettings.commissionBps for this category and, unless
  // they set their own, its subcategories.
  commissionBps  Int?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  parent      Category?              @relation("categoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]             @relation("categoryTree")
  attributes  CategoryAttribute[]
  products    Product[]
  oldSlugs    CategorySlugRedirect[]
  suggestions CategorySuggestion[]   @relation("suggestedParent")
  createdFrom CategorySuggestion[]   @relation("createdCategory")

  @@index([parentId, sortOrder])
  @@map("categories")
}

// Old slugs keep working after a rename (301 to the current slug).
model CategorySlugRedirect {
  slug       String   @id
  categoryId String
  createdAt  DateTime @default(now())

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@map("category_slug_redirects")
}

enum AttributeType {
  text
  number
  select
  multiselect
  boolean
}

// A field sellers fill in for products in this category and its
// subcategories (e.g. Electronics > "Brand", Phones > "Storage").
// `key` is unique along each root-to-leaf branch (checked in the app).
model CategoryAttribute {
  id           String        @id @default(cuid())
  categoryId   String
  key          String
  name         String
  type         AttributeType
  unit         String? // e.g. "GB", "inches"
  options      String[] // choices for select / multiselect
  isRequired   Boolean       @default(false)
  isFilterable Boolean       @default(true)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  category Category                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  values   ProductAttributeValue[]

  @@unique([categoryId, key])
  @@map("category_attributes")
}

enum CategorySuggestionStatus {
  pending
  accepted
  declined
}

model CategorySuggestion {
  id                String                   @id @default(cuid())
  storeId           String
  parentId          String?
  name              String
  note              String?
  status            CategorySuggestionStatus @default(pending)
  response          String?
  createdCategoryId String?
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime                 @default(now())

  store           Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent          Category? @relation("suggestedParent", fields: [parentId], references: [id], onDelete: SetNull)
  createdCategory Category? @relation("createdCategory", fields: [createdCategoryId], references: [id], onDelete: SetNull)
  reviewedBy      User?     @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([storeId])
  @@map("category_suggestions")
}

enum ProductStatus {
  draft
  active
  archived
}

// Visible to shoppers only when status = active, not blocked, and its store
// and category (with every ancestor) are active. See lib/catalog/visibility.ts.
model Product {
  id            String                   @id @default(cuid())
  storeId       String
  categoryId    String
  // Never changes after creation, so links and search results stay valid.
  slug          String                   @unique
  title         String
  description   String
  // Option types and their values, e.g. [{"name":"Size","values":["S","M"]}].
  // Each variant holds one value per option, in the same order.
  options       Json                     @default("[]")
  status        ProductStatus            @default(draft)
  publishedAt   DateTime?
  // Moderation (moderate-after): an admin can block a listing with a reason.
  blockedAt     DateTime?
  blockedReason String?
  blockedById   String?
  // Kept in sync from active variants on every save, for listing,
  // sorting and price filters without a join.
  minPrice      Int                      @default(0)
  maxPrice      Int                      @default(0)
  totalStock    Int                      @default(0)
  // Maintained by a database trigger (title weighted above description).
  searchVector  Unsupported("tsvector")?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  store           Store                   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  category        Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  blockedBy       User?                   @relation("productBlocker", fields: [blockedById], references: [id], onDelete: SetNull)
  variants        ProductVariant[]
  images          ProductImage[]
  attributeValues ProductAttributeValue[]
  orderItems      OrderItem[]

  @@index([storeId, status, updatedAt])
  @@index([categoryId, status, publishedAt])
  @@index([status, publishedAt])
  @@index([searchVector], type: Gin)
  // Typo-tolerant title matching (pg_trgm, enabled in the catalog migration).
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("products")
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  sku            String
  optionValues   String[]
  price          Int // pesewas
  compareAtPrice Int? // pesewas, shown struck through when higher than price
  stock          Int      @default(0)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, sku])
  @@unique([productId, optionValues])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  // Storage pathname, used to delete the file.
  key       String
  alt       String?
  width     Int?
  height    Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

// One row per product per attribute. select/multiselect/text values go in
// `textValues` (one element for text/select), so filtering is an indexed
// array containment check.
model ProductAttributeValue {
  id           String   @id @default(cuid())
  productId    String
  attributeId  String
  textValues   String[]
  numberValue  Float?
  booleanValue Boolean?

  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute CategoryAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
  @@index([attributeId, numberValue])
  @@index([textValues], type: Gin)
  @@map("product_attribute_values")
}

// ---------------------------------------------------------------------------
// Cart and orders
// ---------------------------------------------------------------------------

// One cart per signed-in user, or a guest cart found by a random cookie
// token. A guest cart is merged into the user's cart when they sign in.
model Cart {
  id         String   @id @default(cuid())
  userId     String?  @unique
  guestToken String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([updatedAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

enum OrderStatus {
  awaiting_payment
  paid
  cancelled
  expired
}

enum SubOrderStatus {
  awaiting_payment
  paid
  cancelled
  expired
}

enum DistanceSource {
  pins // both map pins
  area // neighbourhood centres (e.g. East Legon to Tema Community 25)
  town // town centres
  region // regional capitals (last resort)
}

// A checkout. Stock is reserved (decremented) when it's created and given
// back if it expires or is cancelled before payment. Money is in pesewas.
model Order {
  id             String      @id @default(cuid())
  // Human-friendly reference, e.g. "BM-261118-7K3Q9".
  number         String      @unique
  userId         String
  status         OrderStatus @default(awaiting_payment)
  currency       String      @default("GHS")
  itemsTotal     Int
  deliveryTotal  Int
  grandTotal     Int
  reservedUntil  DateTime
  // The same key twice (double-click, retry) returns the existing order.
  idempotencyKey String
  // Delivery address, copied so later edits to the address book don't change the order.
  recipientName  String
  phone          String
  region         GhanaRegion
  city           String
  area           String
  streetAddress  String?
  landmark       String?
  gpsAddress     String?
  latitude       Float?
  longitude      Float?
  paidAt         DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  subOrders SubOrder[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, reservedUntil])
  @@map("orders")
}

// The part of an order fulfilled by one seller, with its own delivery fee.
model SubOrder {
  id             String         @id @default(cuid())
  orderId        String
  storeId        String
  status         SubOrderStatus @default(awaiting_payment)
  itemsTotal     Int
  deliveryFee    Int
  deliveryKm     Float
  distanceSource DistanceSource
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  order Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  store Store       @relation(fields: [storeId], references: [id], onDelete: Restrict)
  items OrderItem[]

  @@unique([orderId, storeId])
  @@index([storeId, status, createdAt])
  @@map("sub_orders")
}

// A line, with what the shopper saw copied at checkout (title, options,
// price) plus the commission rate in force, so later edits change nothing.
model OrderItem {
  id            String   @id @default(cuid())
  subOrderId    String
  productId     String?
  variantId     String?
  title         String
  optionValues  String[]
  sku           String
  imageUrl      String?
  unitPrice     Int
  quantity      Int
  lineTotal     Int
  commissionBps Int
  createdAt     DateTime @default(now())

  subOrder SubOrder        @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  product  Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([subOrderId])
  @@index([variantId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Audit log: who did what to which record. Append-only.
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // e.g. "seller_application.approved"
  entityType String
  entityId   String
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
